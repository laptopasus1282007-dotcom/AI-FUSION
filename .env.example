# CodeSathi AI — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# Never commit the .env file to version control.

# --- Django ---
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- LLM Provider ---
# Supported providers: openai, gemini, openai-compatible
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible endpoint (e.g., Together, Groq, local Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- YouTube Data API (optional) ---
# Leave blank to use YouTube search-link fallback
YOUTUBE_API_KEY=

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=media
